{
  "DryRun": true,
  "EnableRemediation": false,
  "EnableBackup": true,
  "EnableRollback": true,
  "ScanIntervalHours": 24,
  "DebugThresholdHours": 48,
  "RestartServices": false,
  "MaxConcurrentServers": 10,
  "Inventory": {
    "SourceType": "File",
    "FilePath": "config/ServerInventory.sample.csv",
    "Splunk": {
      "BaseUrl": "https://splunk.example.com:8089",
      "SavedSearchOrQuery": "search index=tms_inventory | table customer, hostname, server_type, environment, status",
      "OutputFormat": "json",
      "CredentialPath": "config/splunk.cred.xml"
    }
  },
  "WinRM": {
    "UseSSL": false,
    "Port": 5985,
    "Authentication": "Kerberos",
    "UseGmsa": true,
    "OperationTimeoutSec": 60
  },
  "Filters": {
    "IncludeServerTypes": [],
    "ExcludeServerTypes": [],
    "ExcludeHostnames": []
  },
  "Paths": {
    "RegistryFile": "config/LogFileRegistry.xml",
    "DriveMappingFile": "config/ServerDriveMapping.json",
    "TrackingFile": "data/debug-tracking.json",
    "LogRoot": "logs"
  },
  "Backup": {
    "Mode": "SameFolder",
    "TimestampFormat": "yyyyMMdd_HHmmss"
  },
  "RetentionDays": {
    "Logs": 30,
    "ClosedTrackingRecords": 90
  }
}
